{
  "name": "cabukpos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run agent:build && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import ./tests/ts-resolve.mjs --test \"tests/*.test.ts\"",
    "db:push": "sh -c 'DATABASE_URL=$(grep ^MIGRATE_DATABASE_URL .env.local | cut -d= -f2-) node node_modules/drizzle-kit/bin.cjs push --force' && npm run db:rls",
    "db:rls": "node --env-file=.env.local scripts/db-rls.mjs",
    "db:push:test": "DATABASE_URL=postgres://yigiterturk@localhost:5432/cabukpos_test node node_modules/drizzle-kit/bin.cjs push --force && npm run db:rls:test",
    "db:rls:test": "MIGRATE_DATABASE_URL=postgres://yigiterturk@localhost:5432/cabukpos_test node scripts/db-rls.mjs",
    "agent:build": "esbuild agent/src/main.ts --bundle --platform=node --target=node20 --format=cjs --minify --legal-comments=none --outfile=public/indir/cabukpos-agent.cjs --alias:@=.",
    "agent:dev": "node --import ./tests/ts-resolve.mjs agent/src/main.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acme-client": "^5.4.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
