{
  "name": "cabukpos-app",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "overrides": {
    "follow-redirects": "^1.16.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run agent:build && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "qa:static": "npm run lint && npm run typecheck",
    "test": "node --experimental-strip-types --import ./tests/ts-resolve.mjs --test --test-concurrency=1 tests/*.test.ts",
    "e2e:m9a": "node --env-file-if-exists=.env.local e2e/m9a.mjs",
    "e2e:m8": "node --env-file-if-exists=.env.local e2e/m8.mjs",
    "e2e:iade": "node --env-file-if-exists=.env.local e2e/iade.mjs",
    "e2e:m9b": "node --env-file-if-exists=.env.local e2e/m9b.mjs",
    "e2e:m9c": "node --env-file-if-exists=.env.local e2e/m9c.mjs",
    "e2e:m49": "node --env-file-if-exists=.env.local e2e/m49.mjs",
    "e2e:m3": "node --env-file-if-exists=.env.local e2e/m3.mjs",
    "e2e:m5": "node --env-file-if-exists=.env.local e2e/m5.mjs",
    "e2e:lan": "node --env-file-if-exists=.env.local e2e/lan.mjs",
    "e2e:pilot": "npm run e2e:m3 && npm run e2e:m5 && npm run e2e:lan",
    "e2e:mfa": "node --env-file-if-exists=.env.local e2e/mfa.mjs",
    "e2e:m54": "node --env-file-if-exists=.env.local e2e/m54.mjs",
    "e2e:dogrula": "node --env-file-if-exists=.env.local e2e/dogrula.mjs",
    "e2e:critical": "npm run e2e:m8 && npm run e2e:m9a && npm run e2e:iade && npm run e2e:m9b && npm run e2e:m9c",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup-db.mjs",
    "db:backup:verify": "node scripts/verify-backup.mjs",
    "db:restore:rehearsal": "node scripts/rehearse-restore.mjs",
    "audit:runtime": "node scripts/runtime-audit.mjs",
    "launch:check": "node --env-file-if-exists=.env.local scripts/launch-check.mjs",
    "billing:manual": "node --env-file-if-exists=.env.local scripts/manual-payment.mjs",
    "growth:webhook:smoke": "node scripts/growth-webhook-smoke.mjs",
    "db:push": "sh -c 'DATABASE_URL=$(grep ^MIGRATE_DATABASE_URL .env.local | cut -d= -f2-) node node_modules/drizzle-kit/bin.cjs push --force' && npm run db:rls",
    "db:rls": "node --env-file=.env.local scripts/db-rls.mjs",
    "db:growth:verify": "node --env-file-if-exists=.env.local scripts/verify-growth-schema.mjs",
    "db:verify:billing-report": "node scripts/verify-billing-report-schema.mjs",
    "db:push:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgres://yigiterturk@localhost:5432/cabukpos_test} node node_modules/drizzle-kit/bin.cjs push --force && npm run db:rls:test",
    "db:rls:test": "MIGRATE_DATABASE_URL=${TEST_DATABASE_URL:-postgres://yigiterturk@localhost:5432/cabukpos_test} node scripts/db-rls.mjs",
    "agent:build": "node scripts/build-agent.mjs",
    "agent:dev": "node --import ./tests/ts-resolve.mjs agent/src/main.ts",
    "e2e:m1": "node --env-file-if-exists=.env.local e2e/m1.mjs",
    "e2e:m2": "node --env-file-if-exists=.env.local e2e/m2.mjs",
    "e2e:m4": "node --env-file-if-exists=.env.local e2e/m4.mjs",
    "e2e:m6": "node --env-file-if-exists=.env.local e2e/m6.mjs",
    "e2e:m7": "node --env-file-if-exists=.env.local e2e/m7.mjs",
    "e2e:sifre": "node --env-file-if-exists=.env.local e2e/sifre.mjs",
    "e2e:hq": "node --env-file-if-exists=.env.local e2e/hq.mjs",
    "e2e:transfer": "node --env-file-if-exists=.env.local e2e/transfer.mjs"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dexie": "^4.4.6",
    "drizzle-orm": "^0.45.3",
    "follow-redirects": "^1.16.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "next": "16.4.1",
    "postgres": "^4.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.6",
    "follow-redirects": "^1.16.3"
  },
  "devDependencies": {
    "@cabukpos/acme-client-native": "file:vendor/acme-client-native",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "fake-indexeddb": "^6.2.5",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
