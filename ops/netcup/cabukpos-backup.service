[Unit]
Description=CabukPOS encrypted database backup
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/cabukpos-ops/maintenance.py backup
UMask=0077
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
